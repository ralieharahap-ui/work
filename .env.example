APP_NAME="PT Geosys Energi Prima"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.pt-gep.com

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gep_erp
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@pt-gep.com"
MAIL_FROM_NAME="PT Geosys Energi Prima"

VITE_APP_NAME="${APP_NAME}"

# ── Notifikasi WhatsApp (pengingat tenggat tugas) ─────────────────────
# Selama WHATSAPP_ENABLED=false, pesan tidak pernah dikirim ke pihak mana pun —
# hanya dicatat di riwayat aplikasi dengan status "dilewati".
WHATSAPP_ENABLED=false

# Gateway: log | go_whatsapp | waha | fonnte | wablas | cloud_api | webhook
WHATSAPP_DRIVER=log
WHATSAPP_COUNTRY_CODE=62
WHATSAPP_TIMEOUT=20

# Jadwal & aturan pengingat
WHATSAPP_REMINDER_TIME=08:00
WHATSAPP_REMINDER_DAYS=3,1,0
WHATSAPP_OVERDUE_EVERY_DAYS=1
WHATSAPP_REMINDER_MAX_TASKS=8
WHATSAPP_REMINDER_SKIP_WEEKEND=false

# Salinan ke grup tim (mention PIC sungguhan di dalam grup)
WHATSAPP_GROUP_ENABLED=false
WHATSAPP_GROUP_ID=

# Kredensial — isi sesuai driver yang dipakai

# go_whatsapp — gateway swakelola go-whatsapp-web-multidevice.
# Dijalankan sebagai layanan terpisah (lihat docker-compose.prod.yml, profil
# "whatsapp"), tersambung ke WhatsApp lewat pemindaian QR sekali.
# GOWA_DEVICE_ID hanya perlu diisi bila gateway melayani >1 nomor.
GOWA_BASE_URL=http://whatsapp:3000
GOWA_USERNAME=
GOWA_PASSWORD=
GOWA_DEVICE_ID=

# waha — alternatif gateway swakelola (WAHA / WhatsApp HTTP API).
# Pilih salah satu saja: go_whatsapp ATAU waha.
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

FONNTE_TOKEN=
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
