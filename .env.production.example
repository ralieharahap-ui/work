# ============================================================
#  Salin file ini menjadi  .env.production  lalu isi nilainya.
#  Dipakai oleh docker-compose.prod.yml (jangan commit ke git!).
# ============================================================

# Kunci enkripsi Laravel (WAJIB, permanen). Buat dengan:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# URL publik aplikasi (harus sama dengan domain HTTPS Anda)
APP_URL=https://biomassa.contoh.com

# Domain untuk HTTPS otomatis (Caddy) — arahkan A record ke IP server
DOMAIN=biomassa.contoh.com
ADMIN_EMAIL=admin@contoh.com

# Kredensial database (buat password kuat & acak)
DB_DATABASE=gep_erp
DB_USERNAME=gep
DB_PASSWORD=ganti_password_kuat_disini
DB_ROOT_PASSWORD=ganti_root_password_kuat

# Seed data awal saat pertama deploy (true). Ubah ke false setelah data masuk.
SEED_ON_DEPLOY=true

# (Opsional) port akses langsung tanpa domain — lihat komentar di compose
APP_PORT=8000

# ── Notifikasi WhatsApp (pengingat tenggat tugas) ─────────────────────
# Biarkan false sampai kredensial gateway siap; selama itu pesan hanya dicatat
# di riwayat aplikasi dan tidak dikirim ke mana pun.
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=go_whatsapp     # log | go_whatsapp | fonnte | wablas | cloud_api | webhook
WHATSAPP_REMINDER_TIME=08:00    # jam kirim harian
WHATSAPP_REMINDER_DAYS=3,1,0    # ingatkan H-3, H-1, dan hari-H
WHATSAPP_OVERDUE_EVERY_DAYS=1   # tugas telat diingatkan tiap N hari

# Isi salah satu sesuai WHATSAPP_DRIVER

# go_whatsapp — gateway swakelola, dijalankan lewat profil compose "whatsapp".
# GOWA_USERNAME/PASSWORD dipakai dua arah: melindungi REST API gateway
# (APP_BASIC_AUTH) sekaligus dipakai aplikasi untuk memanggilnya. Buat password
# yang kuat & acak — siapa pun yang tahu ini bisa mengirim WhatsApp atas nama
# nomor perusahaan.
GOWA_BASE_URL=http://whatsapp:3000
GOWA_USERNAME=gepbot
GOWA_PASSWORD=ganti_password_kuat_disini
GOWA_DEVICE_ID=

FONNTE_TOKEN=
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# (Opsional) salinan pengingat ke grup WhatsApp tim
WHATSAPP_GROUP_ENABLED=false
WHATSAPP_GROUP_ID=
